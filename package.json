{
  "name": "@hilbras/remembra",
  "version": "5.0.3",
  "description": "External memory for AI assistants \u2014 remember facts, decisions, roles and history across sessions. MCP server for OpenCode, Claude Code, Cline, Kimi Code and more.",
  "type": "module",
  "bin": {
    "remembra": "dist/index.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./sdk": {
      "types": "./dist/sdk.d.ts",
      "import": "./dist/sdk.js",
      "default": "./dist/sdk.js"
    },
    "./api-contract": {
      "types": "./dist/api-contract.d.ts",
      "import": "./dist/api-contract.js",
      "default": "./dist/api-contract.js"
    },
    "./batch-idempotency": {
      "types": "./dist/batch-idempotency-store.d.ts",
      "import": "./dist/batch-idempotency-store.js",
      "default": "./dist/batch-idempotency-store.js"
    },
    "./providers": {
      "types": "./dist/provider-adapters.d.ts",
      "import": "./dist/provider-adapters.js",
      "default": "./dist/provider-adapters.js"
    },
    "./tenant": {
      "types": "./dist/tenant.d.ts",
      "import": "./dist/tenant.js",
      "default": "./dist/tenant.js"
    },
    "./tenant-directory": {
      "types": "./dist/tenant-directory.d.ts",
      "import": "./dist/tenant-directory.js",
      "default": "./dist/tenant-directory.js"
    },
    "./tenant-directory-file": {
      "types": "./dist/tenant-directory-file.d.ts",
      "import": "./dist/tenant-directory-file.js",
      "default": "./dist/tenant-directory-file.js"
    },
    "./tenant-entities": {
      "types": "./dist/tenant-entities.d.ts",
      "import": "./dist/tenant-entities.js",
      "default": "./dist/tenant-entities.js"
    },
    "./tenant-migration": {
      "types": "./dist/tenant-migration-runner.d.ts",
      "import": "./dist/tenant-migration-runner.js",
      "default": "./dist/tenant-migration-runner.js"
    },
    "./migration-state": {
      "types": "./dist/migration-state.d.ts",
      "import": "./dist/migration-state.js",
      "default": "./dist/migration-state.js"
    },
    "./recovery": {
      "types": "./dist/recovery.d.ts",
      "import": "./dist/recovery.js",
      "default": "./dist/recovery.js"
    },
    "./sqlite-recovery": {
      "types": "./dist/sqlite-recovery.d.ts",
      "import": "./dist/sqlite-recovery.js",
      "default": "./dist/sqlite-recovery.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/test",
    "docs",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc && node scripts/copy-ui.mjs",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "bench:scale": "npm run build && node scripts/bench-scale.mjs",
    "bench:tenant": "npm run build && bash scripts/bench-tenant.sh",
    "release:check": "node scripts/release-gate.mjs",
    "security:check": "node scripts/run-tests.mjs --test dist/test/tenant-http.test.js dist/test/tenant-service.test.js dist/test/tenant-entities-http.test.js dist/test/foundation.test.js dist/test/v5-0-1-security.test.js dist/test/v5-0-1-startup.test.js dist/test/v5-0-1-path-security.test.js dist/test/v5-0-1-snapshot-security.test.js dist/test/v5-0-1-migration.test.js dist/test/v5-0-2-authorization.test.js dist/test/batch-idempotency.test.js",
    "recovery:check": "node scripts/run-tests.mjs --test dist/test/recovery.test.js dist/test/snapshot-integrity.test.js dist/test/migration-state.test.js dist/test/tenant-migration-runner.test.js dist/test/sqlite-recovery.test.js dist/test/v5-0-3-recovery.test.js dist/test/v5-0-3-recovery-state.test.js dist/test/v5-0-3-startup.test.js dist/test/v5-0-3-snapshot.test.js dist/test/v5-0-3-atomic.test.js dist/test/v5-0-3-import.test.js dist/test/v5-0-3-import-recovery.test.js",
    "test": "node scripts/run-tests.mjs --test dist/test/*.test.js",
    "test:raw": "node --test dist/test/*.test.js",
    "docs:check": "node scripts/check-docs.mjs",
    "prepublishOnly": "npm run build && npm test && npm run docs:check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hilbras/Remembra.git"
  },
  "homepage": "https://github.com/Hilbras/Remembra#readme",
  "bugs": {
    "url": "https://github.com/Hilbras/Remembra/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "memory",
    "ai",
    "assistant",
    "context",
    "external-memory",
    "long-term-memory",
    "llm",
    "opencode",
    "claude-code",
    "cline"
  ],
  "author": "Hilbras",
  "license": "MIT",
  "engines": {
    "node": ">=18.14.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "overrides": {
    "@hono/node-server": "1.19.17"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "better-sqlite3": "^11.10.0",
    "yaml": "^2.9.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.8.0"
  }
}
